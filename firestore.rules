rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'admin@meethaq.org' || 
         request.auth.token.email == 'hhhosts@gmail.com' ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Profiles Collection (Matrimonial Bios)
    match /profiles/{profileId} {
      allow read: if true; // Publicly browseable for seekers
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Proposals Collection (Khitbah Requests & Meetings)
    match /proposals/{proposalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Proposal Messages (Supervised Chat Messages)
    match /proposals/{proposalId}/messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Walis Collection (Guardian Verification)
    match /walis/{waliId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isAuthenticated();
    }

    // Celebrations & Invitations
    match /celebrations/{celebrationId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Flagged Messages for Sharia Moderation
    match /flaggedMessages/{flagId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Platform Stats
    match /stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site Static and Special Pages (About Us, Terms, Privacy Policy)
    match /site_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // Site Settings (Layouts, Footer copyright, Widgets configuration)
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }
  }
}
